<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.apache.dolphinscheduler.flink.monitor.mapper.MonitorInstanceMapper">
    <update id="updateHeartbeat">
        update flink_monitor_instance
        set host = #{instance.host},
            update_time = #{instance.updateTime}
        where instance_id = #{instance.instanceId}
    </update>

    <insert id="insertInstance">
        insert into flink_monitor_instance(instance_id, host, update_time)
        values (#{instance.instanceId}, #{instance.host}, #{instance.updateTime})
    </insert>

    <select id="queryAliveInstanceIds" resultType="java.lang.String">
        select instance_id
        from flink_monitor_instance
        where update_time >= #{cutoffTime}
        order by instance_id asc
    </select>
</mapper>
